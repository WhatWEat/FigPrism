FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements.lock ./backend/requirements.lock
RUN pip install --no-cache-dir -r backend/requirements.lock
COPY backend/ ./backend/
RUN pip install --no-cache-dir --no-deps ./backend
COPY config/settings.example.yaml config/domains.yaml ./config/
ENV FIGPRISM_ROOT=/app FIGPRISM_CONFIG=/app/config/local.yaml FIGPRISM_DATA_DIR=/app/data
EXPOSE 8100
CMD ["uvicorn","figprism.main:app","--host","0.0.0.0","--port","8100","--proxy-headers","--forwarded-allow-ips","*"]
